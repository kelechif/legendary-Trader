# prop_algo host env (Windows MT5 path)
# Copy to prop_algo/.env or set in the shell. Do NOT commit real passwords.
# Load manually in PowerShell, e.g.:
#   Get-Content prop_algo\.env | ForEach-Object {
#     if ($_ -match '^\s*#' -or $_ -notmatch '=') { return }
#     $k,$v = $_.Split('=',2); Set-Item -Path "env:$k" -Value $v.Trim()
#   }

# mock | mt5 | ctrader  (compose/Docker stay on mock)
BROKER_ADAPTER=mt5
BROKER_ACCOUNTS=ACC1

# Required for BROKER_ADAPTER=mt5 (Windows host + local MetaTrader 5 terminal)
MT5_LOGIN=YOUR_MT5_LOGIN
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_MT5_SERVER

# Optional: path to terminal64.exe if auto-detect fails
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Optional watchlist (comma-separated)
# MT5_SYMBOLS=EURUSD,GBPUSD

# Host services talking to compose Redis
REDIS_HOST=127.0.0.1
PYTHONPATH=prop_algo